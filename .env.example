# ─────────────────────────────────────────────────────────────────────────────
# Voice Chatbot configuration. Copy to .env and fill in your own values.
# Never commit .env (it is in .gitignore).
#
# Each capability (chat, embeddings, speech-to-text, text-to-speech, rerank)
# has its own *_BASE_URL / *_API_KEY / *_MODEL, so you can mix providers.
# Every *_BASE_URL is an OpenAI-compatible root that ends in /v1.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chat / vision model ─────────────────────────────────────────────────────
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=sk-your-key
CHAT_MODEL=gpt-4o-mini
# true only for vLLM servers (sends top_k and turns Qwen3 "thinking" off).
# OpenAI and most hosted APIs reject those fields, so keep false for them.
CHAT_VLLM=false
CHAT_TIMEOUT_S=60

# ── Embeddings ──────────────────────────────────────────────────────────────
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=sk-your-key
EMBED_MODEL=text-embedding-3-large
# Must equal the vector(N) size in server/db/migrations/0002_documents.sql (2048 by default).
EMBED_DIMS=2048
# plain                -> send text as-is (OpenAI, Ollama, most providers)
# qwen_chat_template   -> wrap text in the Qwen chat template (Qwen3 embedding models on vLLM)
EMBED_INPUT_STYLE=plain
# true only if the embedding endpoint accepts images (e.g. Qwen3-VL-Embedding on vLLM)
EMBED_IMAGES=false

# ── Speech-to-text ──────────────────────────────────────────────────────────
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=sk-your-key
ASR_MODEL=whisper-1
ASR_TIMEOUT_S=30

# ── Text-to-speech ──────────────────────────────────────────────────────────
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=sk-your-key
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Must be pcm (24 kHz, 16-bit, mono): the browser plays raw PCM.
TTS_FORMAT=pcm

# ── Rerank (optional; leave empty to skip) ──────────────────────────────────
# Any endpoint with POST {base}/rerank -> {"results":[{"index", "relevance_score"}]}
RERANK_BASE_URL=
RERANK_API_KEY=

# ── Storage ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vchat:vchat@localhost:5433/vchat
OBJECT_DIR=./data/objects


# ─────────────────────────────────────────────────────────────────────────────
# Alternative: self-hosted, OpenAI-compatible servers (vLLM, Kokoro-FastAPI,
# Speaches, or one gateway in front of them). Replace the blocks above with:
# ─────────────────────────────────────────────────────────────────────────────
# CHAT_BASE_URL=https://models.example.com/v1
# CHAT_API_KEY=your-gateway-key
# CHAT_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# CHAT_VLLM=true
# EMBED_BASE_URL=https://models.example.com/v1
# EMBED_MODEL=your-embedding-model
# EMBED_DIMS=2048
# EMBED_INPUT_STYLE=qwen_chat_template
# EMBED_IMAGES=true
# ASR_BASE_URL=https://models.example.com/v1
# ASR_MODEL=Systran/faster-whisper-large-v3
# TTS_BASE_URL=https://models.example.com/v1
# TTS_MODEL=kokoro
# TTS_VOICE=af_heart
# RERANK_BASE_URL=https://models.example.com/v1
